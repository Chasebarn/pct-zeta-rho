{
  "name": "pct-zeta-rho",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "python3 scripts/build_site.py",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && node scripts/check-site.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1"
  }
}
