{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/philanthropy",
      "destination": "/about#service",
      "permanent": true
    },
    {
      "source": "/philanthropy.html",
      "destination": "/about#service",
      "permanent": true
    },
    {
      "source": "/v2/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/rush.html",
      "destination": "/rush",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/rush",
      "destination": "/rush",
      "permanent": true
    },
    {
      "source": "/fallrush",
      "destination": "/rush",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "https://www.usf.edu/business/talent-development/internships-find.aspx",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
